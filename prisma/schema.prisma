// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  admin     Admin?
  teacher   Teacher?
  parent    Parent?
  auditLogs AuditLog[]
  notifications Notification[]
  submittedSubmissions Submission[] @relation("SubmittedBy")
  reviewedSubmissions Submission[] @relation("ReviewedBy")
  approvedApprovals Approval[] @relation("ApprovedBy")
  generatedReports Report[] @relation("GeneratedBy")
  postedAnnouncements Announcement[] @relation("PostedBy")
  approvedAnnouncements Announcement[] @relation("ApprovedBy")
  postedEvents Event[] @relation("PostedBy")
  approvedEvents Event[] @relation("ApprovedBy")
  attendance Attendance[] @relation("RecordedBy")
  performance Performance[] @relation("RecordedBy")
  results Result[] @relation("PublishedBy")

  @@map("users")
}

// User roles enum
enum UserRole {
  ADMIN
  TEACHER
  PARENT
}

// Admin model
model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

// Teacher model
model Teacher {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String
  lastName    String
  phone       String?
  employeeId  String   @unique
  department  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes Class[]  @relation("TeacherClass")

  @@map("teachers")
}

// Parent model
model Parent {
  id         String   @id @default(cuid())
  userId     String   @unique
  firstName  String
  lastName   String
  phone      String?
  occupation String?
  address    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students Student[]

  @@map("parents")
}

// Student model
model Student {
  id                  String   @id @default(cuid())
  registrationNumber  String   @unique
  firstName           String
  lastName            String
  dateOfBirth         DateTime
  gender              Gender
  address             String?
  phone               String?
  email               String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Foreign Keys
  classId String?
  parentId String?

  // Relations
  class       Class?        @relation("ClassStudents", fields: [classId], references: [id])
  parent      Parent?       @relation(fields: [parentId], references: [id])
  attendance  Attendance[]
  performance Performance[]
  results     Result[]
  studentSubmissions Submission[] @relation("TargetStudent")

  @@map("students")
}

// Gender enum
enum Gender {
  MALE
  FEMALE
}

// Class model
model Class {
  id             String   @id @default(cuid())
  name           String
  grade          String
  section        String?
  maxStudents    Int
  currentStudents Int    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Foreign Keys
  teacherId String?

  // Relations
  teacher  Teacher?   @relation("TeacherClass", fields: [teacherId], references: [id])
  students Student[]  @relation("ClassStudents")
  attendance Attendance[]
  performance Performance[]
  results Result[]
  classSubmissions Submission[] @relation("TargetClass")

  @@map("classes")
}

// Attendance model
model Attendance {
  id          String          @id @default(cuid())
  date        DateTime
  status      AttendanceStatus
  remarks     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Foreign Keys
  studentId String
  classId   String
  recordedBy String

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  user    User    @relation("RecordedBy", fields: [recordedBy], references: [id])

  @@unique([studentId, classId, date])
  @@map("attendance")
}

// Attendance status enum
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// Performance model
model Performance {
  id             String           @id @default(cuid())
  subject        String
  assessmentType AssessmentType
  score          Float
  maxScore       Float
  grade          String?
  remarks        String?
  assessmentDate DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Foreign Keys
  studentId  String
  classId    String
  recordedBy String

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  user    User    @relation("RecordedBy", fields: [recordedBy], references: [id])

  @@map("performance")
}

// Assessment type enum
enum AssessmentType {
  QUIZ
  TEST
  ASSIGNMENT
  PROJECT
  EXAM
}

// Result model
model Result {
  id            String    @id @default(cuid())
  examType      ExamType
  term          String
  academicYear  String
  subjects      Json      // Store array of subject results
  totalMarks    Float
  maxTotalMarks Float
  percentage    Float
  grade         String
  rank          Int?
  remarks       String?
  publishedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Foreign Keys
  studentId   String
  classId     String
  publishedBy String

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  user    User    @relation("PublishedBy", fields: [publishedBy], references: [id])

  @@map("results")
}

// Exam type enum
enum ExamType {
  MIDTERM
  FINAL
  UNIT_TEST
  PRACTICAL
}

// Announcement model
model Announcement {
  id            String           @id @default(cuid())
  title         String
  content       String
  type          AnnouncementType
  targetAudience TargetAudience
  targetId      String?
  status        SubmissionStatus @default(DRAFT)
  attachments   Json?            // Store array of file URLs
  publishedAt   DateTime?
  expiresAt     DateTime?
  rejectionReason String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Foreign Keys
  postedBy   String?
  approvedBy String?

  // Relations
  postedByUser   User?  @relation("PostedBy", fields: [postedBy], references: [id])
  approvedByUser User?  @relation("ApprovedBy", fields: [approvedBy], references: [id])
  submissions    Submission[]

  @@map("announcements")
}

// Announcement type enum
enum AnnouncementType {
  GENERAL
  URGENT
  ACADEMIC
  EVENT
}

// Event model
model Event {
  id            String           @id @default(cuid())
  title         String
  description   String
  type          EventType
  startDate     DateTime
  endDate       DateTime
  location      String?
  targetAudience TargetAudience
  targetId      String?
  status        SubmissionStatus @default(DRAFT)
  attachments   Json?            // Store array of file URLs
  publishedAt   DateTime?
  rejectionReason String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Foreign Keys
  postedBy   String?
  approvedBy String?

  // Relations
  postedByUser   User?  @relation("PostedBy", fields: [postedBy], references: [id])
  approvedByUser User?  @relation("ApprovedBy", fields: [approvedBy], references: [id])
  submissions    Submission[]

  @@map("events")
}

// Event type enum
enum EventType {
  ACADEMIC
  SPORTS
  CULTURAL
  MEETING
  HOLIDAY
}

// Target audience enum
enum TargetAudience {
  ALL
  TEACHERS
  PARENTS
  SPECIFIC_CLASS
  SPECIFIC_STUDENT
}

// Submission model (for approval workflow)
model Submission {
  id            String           @id @default(cuid())
  type          SubmissionType
  title         String
  content       String
  data          Json             // Store additional data based on type
  targetAudience TargetAudience
  targetId      String?
  status        SubmissionStatus @default(DRAFT)
  rejectionReason String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Foreign Keys
  submittedBy String?
  reviewedBy  String?
  announcementId String?
  eventId String?

  // Relations
  submittedByUser User?     @relation("SubmittedBy", fields: [submittedBy], references: [id])
  reviewedByUser  User?     @relation("ReviewedBy", fields: [reviewedBy], references: [id])
  approvals      Approval[]
  announcement   Announcement? @relation(fields: [announcementId], references: [id])
  event          Event? @relation(fields: [eventId], references: [id])
  student        Student? @relation("TargetStudent", fields: [targetId], references: [id], map: "submissions_student_fkey")
  class          Class? @relation("TargetClass", fields: [targetId], references: [id], map: "submissions_class_fkey")

  @@map("submissions")
}

// Submission type enum
enum SubmissionType {
  ANNOUNCEMENT
  EVENT
  ATTENDANCE
  PERFORMANCE
}

// Submission status enum
enum SubmissionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// Approval model
model Approval {
  id         String   @id @default(cuid())
  status     ApprovalStatus
  comments   String?
  approvedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Foreign Keys
  submissionId String
  approvedBy   String

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User       @relation("ApprovedBy", fields: [approvedBy], references: [id])

  @@map("approvals")
}

// Approval status enum
enum ApprovalStatus {
  APPROVED
  REJECTED
}

// Notification model
model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  actionUrl   String?
  actionText  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Foreign Keys
  userId String

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// Notification type enum
enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// Report model
model Report {
  id          String       @id @default(cuid())
  name        String
  type        ReportType
  parameters  Json         // Store report parameters
  fileUrl     String?
  fileSize    Int?
  status      ReportStatus @default(GENERATING)
  generatedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Foreign Keys
  generatedBy String

  // Relations
  user User @relation("GeneratedBy", fields: [generatedBy], references: [id])

  @@map("reports")
}

// Report type enum
enum ReportType {
  ATTENDANCE
  PERFORMANCE
  RESULTS
  STUDENT_LIST
  TEACHER_ACTIVITY
  PARENT_LIST
}

// Report status enum
enum ReportStatus {
  GENERATING
  COMPLETED
  FAILED
}

// Audit log model
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // Foreign Keys
  userId String

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}